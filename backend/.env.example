# ==========================================
# Zentra Digital - Backend Environment Configuration
# ==========================================

# Port the backend server will listen on (default 5000)
PORT=5000

# Secret key used for signing and verifying JWT tokens
# In production, replace with a long, secure random string
JWT_SECRET=zentra-enterprise-jwt-secret-key-2026

# MongoDB Connection URI (Local instance or MongoDB Atlas Cloud connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/zentra_digital

# Allowed Client / Frontend Origin for CORS (optional, defaults to allow all origins with credentials)
# CORS_ORIGIN=https://your-frontend-domain.vercel.app

# Brevo (Sendinblue) Transactional Email Configuration (Used for Password Reset OTP)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=zentradigital.inr@gmail.com
BREVO_SENDER_NAME=Zentra Digital Security
