# ==========================================
# Zentra Digital - Frontend Environment Configuration
# ==========================================

# Base URL for the Backend REST API
# In local development (with Vite proxy), leave as /api or empty.
# In production (e.g. deployed to Vercel/Netlify with backend on Render):
# VITE_API_BASE_URL=https://your-backend-domain.com/api
VITE_API_BASE_URL=/api

# WebSocket URL for real-time notifications & chat
# In local development, defaults to current host /ws.
# In production (e.g. deployed on Render/VPS):
# VITE_WS_URL=wss://your-backend-domain.com/ws
VITE_WS_URL=
